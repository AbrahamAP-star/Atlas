# Hardhat 3 lee estas variables como Configuration Variables (configVariable()
# en hardhat.config.ts). No se cargan automáticamente vía dotenv: exporta el
# archivo antes de correr un comando, p.ej.
#   export $(grep -v '^#' .env | xargs) && npx hardhat run scripts/deploy.ts --network baseSepolia
# o usa `npx hardhat keystore set NOMBRE_VARIABLE` para guardarlas cifradas
# en vez de tenerlas en texto plano (recomendado para DEPLOYER_PRIVATE_KEY).

# RPC de Base Sepolia (testnet) — Alchemy, Infura, o el RPC público de Base
BASE_SEPOLIA_RPC_URL=

# RPC de Base mainnet — solo se usa en Fase 6 (deploy final)
BASE_MAINNET_RPC_URL=

# Private key de la wallet que despliega el contrato (SIN el prefijo 0x
# o con él, según lo que pida el plugin de cuentas; nunca la del cliente final).
# NUNCA subir un .env real con esta variable rellena a git.
DEPLOYER_PRIVATE_KEY=

# API key del explorador de bloques de Base (Basescan/Etherscan) para verificar
# el contrato tras el deploy — se usa en Fase 3/6.
BASESCAN_API_KEY=

# Proveedor de pinning IPFS para el metadata de campañas (Fase 5).
# Pendiente confirmar con el cliente cuál usar (ver 04_STATUS.md → Riesgos abiertos).
PINATA_JWT=
