{
  "name": "crowdfunding-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend minimo: proxy de subida a Pinata/IPFS. Oculta el JWT de Pinata del bundle publico del frontend (ver docs/05_CRITICAL_REVIEW.md).",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -b",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "audit:uploads": "tsx scripts/audit-uploads.ts"
  },
  "dependencies": {
    "express": "5.2.1",
    "multer": "2.2.0",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "viem": "2.54.1",
    "better-sqlite3": "12.11.1"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/multer": "2.2.0",
    "@types/cors": "2.8.19",
    "@types/node": "26.1.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/supertest": "7.2.1",
    "tsx": "4.23.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "supertest": "7.2.2"
  }
}
