# JWT de Pinata con scope restringido (solo pinFileToIPFS/pinJSONToIPFS).
# NUNCA el JWT admin de la cuenta completa. Ver docs/05_CRITICAL_REVIEW.md.
PINATA_JWT=

# Origen exacto permitido por CORS (frontend2.0 en dev corre en :8080
# via @lovable.dev/vite-tanstack-config). Cambiar al dominio real en produccion.
FRONTEND_ORIGIN=http://localhost:8080

PORT=3001

# Point 11 of docs/09_ROADMAP_MEJORAS.md: credential for POST /api/admin/unpin
# (emergency content takedown). Separate from PINATA_JWT and from any wallet
# session token on purpose — generate a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Sent by the caller as header: X-Admin-Key: <value>
ADMIN_UNPIN_KEY=
